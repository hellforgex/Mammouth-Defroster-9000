{
  "server": {
    "port": 8000,
    "host": "127.0.0.1",
    "enforce_auth": true,
    "api_token": "",
    "allow_admin_shell": false,
    "enable_tls": false,
    "ssl_certfile": "",
    "ssl_keyfile": "",
    "registration_token": "",
